{
  "name": "eventify-backend",
  "version": "1.0.0",
  "description": "Eventify backend with Node.js, Express, and Prisma",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:render": "prisma db push && node server.js",
