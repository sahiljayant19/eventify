{
  "name": "eventify-backend",
  "version": "1.0.0",
  "description": "Eventify backend with Node.js, Express, and Prisma",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:render": "prisma db push && node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "express": "^4.18.2",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0",
    "mysql2": "^3.6.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": ["eventify", "backend", "nodejs", "express", "prisma", "mysql"],
