PORT=8080

NODE_ENV=development

BASE_URL="http://localhost:8080"
# BASE_URL="https://your-backend.onrender.com"

CLIENT_URL="http://localhost:3000"
# Use comma-separated origins if you host multiple frontends.
# CLIENT_URL="https://your-project.vercel.app,https://yourusername.github.io"

DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/eventify"
# DATABASE_URL="mysql://eventify_user:StrongPass123@mysql-1234.aivencloud.com:3306/eventify"

JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

