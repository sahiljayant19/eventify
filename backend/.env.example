PORT=5000
NODE_ENV=development

# Frontend URLs
CLIENT_URL=http://127.0.0.1:5500
BASE_URL=http://localhost:5000

# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster-host> with your Atlas values.
# If your password contains special characters, URL-encode them.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/eventify?retryWrites=true&w=majority&appName=eventify-cluster

# Use a long, random value in production.
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d
