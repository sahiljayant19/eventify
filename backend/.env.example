PORT=5000
NODE_ENV=development

# Database URL. For production, use your Aiven Database
DATABASE_URL="mysql://root:password@localhost:3306/eventify"

# MySQL connection settings. Use Aiven values in production.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=eventify
DB_PORT=3306

# Use a long, random value in production.
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN="7d"
