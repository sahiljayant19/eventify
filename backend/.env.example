PORT=8080
NODE_ENV=development

# Local frontend URL. For production, use your Vercel URL.
CLIENT_URL=http://127.0.0.1:5500

# MySQL connection settings. Use Aiven values in production.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=eventify
DB_PORT=3306

# Use a long, random value in production.
JWT_SECRET=replace_with_a_strong_secret
